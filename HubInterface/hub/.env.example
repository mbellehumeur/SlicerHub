# Slicer hub — Anthropic NL → IDC SearchQuery (+ segment label i18n fallback)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Used only by /idc-mcp-proxy (Streamable HTTP), not by /api/hub/idc-nl
# HUB_IDC_MCP_UPSTREAM_URL=https://api.imaging.datacommons.cancer.gov/mcp
# Hub payload store TTL (seconds). Default 1800 — keep LiveScene chunk payloads
# available for hub-mirror sessions longer than the old 300s default.
# HUB_HTTP_PAYLOAD_TTL_SECONDS=1800
# Loaded automatically by hub.py via python-dotenv when present.

# Auth: mock (default) | oidc — see docs/oidc.md (Auth0 / Entra / Google)
# HUB_AUTH_MODE=mock
# HUB_REQUIRE_AUTH=false

# ---------------------------------------------------------------------------
# Auth0 OIDC (simplest starter IdP — free developer tenant)
# Dashboard: Applications → Create → Regular Web Application
# Allowed Callback URLs must match HUB_OIDC_REDIRECT_URI exactly.
# On Azure Web App: set these as Application settings (no .env needed).
# Issuer = Auth0 Domain with https:// (no trailing path), e.g.
#   https://YOUR_TENANT.us.auth0.com
# ---------------------------------------------------------------------------
# HUB_AUTH_MODE=oidc
# HUB_OIDC_ISSUER=https://YOUR_TENANT.us.auth0.com
# HUB_OIDC_CLIENT_ID=
# HUB_OIDC_CLIENT_SECRET=
# HUB_OIDC_REDIRECT_URI=https://<your-app>.azurewebsites.net/oauth/callback
# HUB_PUBLIC_BASE_URL=https://<your-app>.azurewebsites.net
# HUB_JWT_SECRET=<long-random-string-not-the-dev-default>
# HUB_OIDC_TOPIC_CLAIM=email
# HUB_OIDC_SCOPES=openid email profile
# Optional: SPA origins for return_to (same-host /worklist-client/ needs none;
# localhost is always allowed)
# HUB_OIDC_RETURN_ORIGINS=

# Local Auth0 (dev hub on :2018 — add this callback in Auth0 too)
# HUB_OIDC_REDIRECT_URI=http://127.0.0.1:2018/oauth/callback
# HUB_PUBLIC_BASE_URL=http://127.0.0.1:2018

# Alternates: Entra  HUB_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#             Google HUB_OIDC_ISSUER=https://accounts.google.com
