# Used via fly.toml ignorefile (paths relative to HubInterface/ build context).

**/.git
**/.gitignore
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.venv
**/venv
**/.env
**/.env.*
!**/.env.example

hub/slicer-hub.zip
hub/.env
hub/.env.*
hub/__pycache__
hub/Lib/__pycache__
hub/docs
hub/*.md
hub/make_zip.py
hub/build_clients.sh
hub/deploy-fly.sh
hub/publish-docker.sh
hub/Dockerfile
hub/Dockerfile.fly
hub/Dockerfile.slim
hub/.dockerignore.fly
hub/.dockerignore.slim

python_client/**/__pycache__
python_client/**/*.egg-info
python_client/.venv
